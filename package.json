{
  "name": "3dmodelist",
  "productName": "3DModelist",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "3DModelist — reference in, low-poly model out: Claude agent + Blender + image-to-3D generators",
  "author": "Kostiantyn",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5274",
    "server": "node server/server.mjs",
    "build": "vite build",
    "start": "npm run build && node server/server.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "MODELIST_DEV_URL=http://localhost:5274 electron .",
    "icon": "electron scripts/prepare-icon.cjs",
    "i18n": "node scripts/check-i18n.mjs",
    "dist": "npm run icon && npm run build && electron-builder --mac --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  }
}
